# Edit to taste, then run ./install.sh   (this file is sourced by bash)

# --- Theme names (must match the folder names under ~/.themes and ~/.icons) ---
GTK_THEME="OS-X-Leopard-1.2"
WM_THEME="OS-X-Leopard-1.2"
ICON_THEME="Mac-OS-X-Lion-master"
CINNAMON_THEME="Mint-X-Aqua"          # the Leopard shell theme was buggy, keep Mint-X-Aqua
BUTTON_LAYOUT="close,minimize,maximize:"

# Leave empty to keep the current value.
# The Leopard theme itself names DMZ-Black (black arrow, white outline) as its cursor.
CURSOR_THEME=""                        # e.g. "DMZ-Black"
WALLPAPER=""                           # absolute path to an image file
CLOCK_FORMAT="%a %b%e  %H:%M"          # Cinnamon calendar applet; Mac-like: "%a %H:%M"

# --- Where to get the artwork --------------------------------------------
# install.sh prefers a copy in ./assets/<name>.tar.gz or <name>.zip (run
# ./snapshot-assets.sh on your current machine to create those: exact, offline,
# reproducible). Otherwise it downloads from the URL below if one is set.
LEOPARD_URL="https://github.com/B00merang-Project/OS-X-Leopard/archive/HEAD.zip"
CHEETAH_URL="https://github.com/B00merang-Project/Mac-OS-X-Cheetah/archive/HEAD.zip"
LION_URL=""                            # no verified upstream URL: use snapshot-assets.sh

# --- Packages (Linux Mint 21/22, installed with apt) -----------------------
APT_PACKAGES="curl unzip python3 gtk2-engines-murrine gtk2-engines-pixbuf qt5-style-plugins fonts-lato fonts-inter dmz-cursor-theme"
